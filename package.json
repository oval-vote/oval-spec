{
  "name": "oval-spec",
  "version": "0.0.1",
  "private": true,
  "license": "CC-BY-4.0",
  "description": "The Oval specification and its website",
  "repository": "github:oval-vote/oval-spec",
  "homepage": "https://spec.oval.vote",
  "scripts": {
    "build": "node .scripts/build.mjs",
    "dev": "node .scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "grammar": "node .scripts/grammar.mjs",
    "grammar:check": "node .scripts/grammar.mjs --check",
    "shape": "node .scripts/shape.mjs",
    "shape:check": "node .scripts/shape.mjs --check",
    "check": "npm run format:check && npm run grammar:check && npm run shape:check && npm run spell && npm run check --workspace packages/oval-schema",
    "test": "npm run build && npm run check",
    "spell": "cspell --no-progress",
    "release": "node .scripts/release.mjs"
  },
  "devDependencies": {
    "cspell": "^10.4.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "spec-md": "3.1.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
